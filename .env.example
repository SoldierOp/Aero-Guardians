# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=peatguard_db
POSTGRES_USER=peatguard_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Database connection URL (update password to match above)
DATABASE_URL=postgresql://peatguard_admin:CHANGE_THIS_TO_SECURE_PASSWORD@postgres:5432/peatguard_db

# ============================================
# BACKEND API CONFIGURATION
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# DOMAIN & CORS CONFIGURATION
# ============================================
DOMAIN_NAME=peatguard.live
ALLOWED_ORIGINS=https://peatguard.live,https://www.peatguard.live,http://localhost:8501

# ============================================
# TWILIO CONFIGURATION (WhatsApp Alerts)
# ============================================
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp sandbox number (default) or your approved number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Recipient phone number (format: whatsapp:+62XXXXXXXXXX)
ALERT_WHATSAPP_NUMBER=whatsapp:+62XXXXXXXXXX

# Optional: Additional alert recipients (comma-separated)
# ADDITIONAL_ALERT_NUMBERS=whatsapp:+62111111111,whatsapp:+62222222222

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Alert thresholds (customize based on your requirements)
TEMP_THRESHOLD_HIGH=35.0
TEMP_THRESHOLD_CRITICAL=40.0
VOC_THRESHOLD_HIGH=1000
VOC_THRESHOLD_CRITICAL=2000
PM25_THRESHOLD_HIGH=75
PM25_THRESHOLD_CRITICAL=150

# ============================================
# SENSOR CONFIGURATION
# ============================================
# Number of sensors in your network
SENSOR_COUNT=3

# Sensor data retention (days)
DATA_RETENTION_DAYS=90

# Sensor health check interval (seconds)
SENSOR_CHECK_INTERVAL=300

# ============================================
# MACHINE LEARNING MODEL
# ============================================
# Model file path (relative to backend directory)
ML_MODEL_PATH=../models/fire_prediction_model.h5
TFLITE_MODEL_PATH=../models/fire_prediction_model.tflite
SCALER_PARAMS_PATH=../models/scaler_params.h

# Model prediction threshold (0.0 - 1.0)
FIRE_RISK_THRESHOLD=0.75

# ============================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# ALERT_EMAIL_RECIPIENTS=admin@yourdomain.com,team@yourdomain.com

# ============================================
# REDIS CACHE (Optional - for scaling)
# ============================================
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# CACHE_TTL=300

# ============================================
# MONITORING & LOGGING (Optional)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# ENABLE_METRICS=True
# METRICS_PORT=9090

# ============================================
# DEVELOPMENT SETTINGS (Only for local dev)
# ============================================
# RELOAD=True
# WORKERS=1

# ============================================
# SECURITY SETTINGS
# ============================================
# JWT token expiration (minutes)
JWT_EXPIRY_MINUTES=1440

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Maximum file upload size (MB)
MAX_UPLOAD_SIZE_MB=10

# ============================================
# BACKUP CONFIGURATION
# ============================================
# AWS S3 for backups (optional)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=peatguard-backups
# AWS_REGION=ap-southeast-1

# ============================================
# GENERATION COMMANDS
# ============================================
# Generate secure database password:
#   openssl rand -base64 32
#
# Generate secret key:
#   openssl rand -hex 32
#
# Generate random string:
#   openssl rand -base64 24
